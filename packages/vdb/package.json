{
  "name": "@pmndrs/vdb",
  "version": "0.1.0",
  "description": "Sparse NanoVDB volumes on WebGPU: engine-free WGSL core, pure-TS CPU tools, three.js adapter",
  "license": "MIT",
  "homepage": "https://pmndrs.github.io/vdb/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/vdb.git",
    "directory": "packages/vdb"
  },
  "bugs": {
    "url": "https://github.com/pmndrs/vdb/issues"
  },
  "keywords": [
    "nanovdb",
    "openvdb",
    "webgpu",
    "wgsl",
    "three",
    "threejs",
    "volume"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "default": "./dist/three/index.js"
    },
    "./pnanovdb.wgsl": "./vendor/pnanovdb.wgsl"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "vendor/pnanovdb.wgsl",
    "vendor/NOTICE",
    "vendor/LICENSE",
    "vendor/VENDOR.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build --force",
    "test": "vitest run"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.60",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "three": ">=0.187.0 <0.188.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "three": "0.187.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}
