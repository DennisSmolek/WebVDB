{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Workspace-only source resolution. Published manifests always resolve to
    // dist, including consumers that enable Node's `development` condition.
    "baseUrl": ".",
    "paths": {
      "@pmndrs/vdb": ["packages/vdb/src/core/index.ts"],
      "@pmndrs/vdb/tools": ["packages/vdb/src/tools/index.ts"],
      "@pmndrs/vdb/three": ["packages/vdb/src/three/index.ts"],
      "@pmndrs/vdb/pnanovdb.wgsl": ["packages/vdb/vendor/pnanovdb.wgsl"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  }
}
