{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Workspace-only source resolution. Published manifests always resolve to
    // dist, including consumers that enable Node's `development` condition.
    "baseUrl": ".",
    "paths": {
      "nanovdb-wgsl": ["packages/nanovdb-wgsl/src/index.ts"],
      "nanovdb-wgsl/pnanovdb.wgsl": ["packages/nanovdb-wgsl/vendor/pnanovdb.wgsl"],
      "three-nanovdb": ["packages/three-nanovdb/src/index.ts"],
      "vdb-web-tools": ["packages/vdb-web-tools/src/index.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  }
}
