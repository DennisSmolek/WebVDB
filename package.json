{
  "name": "webvdb",
  "version": "0.0.0",
  "private": true,
  "description": "OpenVDB/NanoVDB volumes on the web: WGSL traversal, three.js TSL rendering, pure-TS CPU tooling",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --testTimeout 30000",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @webvdb/examples dev",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc --build",
    "docs:snippets": "node scripts/docs-snippets.mjs",
    "docs:check": "node scripts/docs-snippets.mjs --check && tsc --noEmit -p docs/snippets/tsconfig.json",
    "pack:dry": "pnpm --filter @pmndrs/vdb exec npm pack --dry-run",
    "verify:packed-subpaths": "node scripts/verify-packed-subpaths.mjs",
    "fixtures": "node scripts/fetch-wdas-cloud.mjs && node scripts/fetch-embergen-pack.mjs && node scripts/fetch-vdb-samples.mjs",
    "fixtures:wdas": "node scripts/fetch-wdas-cloud.mjs",
    "fixtures:embergen": "node scripts/fetch-embergen-pack.mjs",
    "fixtures:vdb-samples": "node scripts/fetch-vdb-samples.mjs",
    "fixtures:bake": "node scripts/bake-fixtures.mjs",
    "fixtures:bake-sequence": "node scripts/bake-vdb-sequence.mjs",
    "wgsl:chunks": "node scripts/extract-wgsl-chunks.mjs",
    "wgsl:variants": "pnpm build && node scripts/check-wgsl-variants.mjs",
    "wgsl:size": "node scripts/wgsl-size.mjs",
    "parity:native": "node scripts/run-native-parity.mjs",
    "hardware:smoke": "node scripts/run-hardware-checks.mjs",
    "hardware:perf": "WEBVDB_PERF=1 node scripts/run-hardware-checks.mjs",
    "k3:parity": "K3_FRAME_PARITY=1 playwright test e2e/k3-frame.spec.ts -g \"parity render\" && node scripts/k3/compare.mjs --ours artifacts/k3/ours --reference fixtures/k3-reference/75e7345 --heatmap artifacts/k3/diff"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.8.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/vdb.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pmndrs/vdb/issues"
  },
  "homepage": "https://github.com/pmndrs/vdb#readme"
}
