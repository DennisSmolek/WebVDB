{
  "name": "webvdb",
  "version": "0.0.0",
  "private": true,
  "description": "OpenVDB/NanoVDB volumes on the web: WGSL traversal, three.js TSL rendering, pure-TS CPU tooling",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @webvdb/examples dev",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc --build",
    "pack:dry": "pnpm --filter @pmndrs/vdb exec npm pack --dry-run",
    "verify:packed-subpaths": "node scripts/verify-packed-subpaths.mjs",
    "fixtures": "node scripts/fetch-wdas-cloud.mjs && node scripts/fetch-embergen-pack.mjs && node scripts/fetch-vdb-samples.mjs",
    "fixtures:wdas": "node scripts/fetch-wdas-cloud.mjs",
    "fixtures:embergen": "node scripts/fetch-embergen-pack.mjs",
    "fixtures:vdb-samples": "node scripts/fetch-vdb-samples.mjs",
    "fixtures:bake": "node scripts/bake-fixtures.mjs",
    "fixtures:bake-sequence": "node scripts/bake-vdb-sequence.mjs",
    "parity:native": "node scripts/run-native-parity.mjs",
    "hardware:smoke": "node scripts/run-hardware-checks.mjs",
    "hardware:perf": "WEBVDB_PERF=1 node scripts/run-hardware-checks.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@webgpu/types": "^0.1.60",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DennisSmolek/WebVDB.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/DennisSmolek/WebVDB/issues"
  },
  "homepage": "https://github.com/DennisSmolek/WebVDB#readme"
}
